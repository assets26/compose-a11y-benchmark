                     vault.addIdentity(stored)\n                        busy = false\n                        onDone()\n                    }\n                },\n                modifier = Modifier.weight(1f),\n            ) { Text(if (busy) \"Generating\u2026\" else \"Generate\") }\n            OutlinedButton(onClick = onCancel, modifier = Modifier.weight(1f)) { Text(\"Back\") }\n        }\n    }\n}"}
