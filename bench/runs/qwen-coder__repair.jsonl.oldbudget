    )\\n      }\\n    },\\n    title = {\\n      WhatsAppMessageUserInfo(messageUiState = messageUiState)\\n    },\\n    actions = {\\n      IconButton(\\n        onClick = { navigateToVideoCall(true) },\\n        modifier = Modifier.size(26.dp)\\n      ) {\\n        Icon(\\n          imageVector = WhatsAppIcons.Video,\\n          tint = MaterialTheme.colorScheme.tertiary,\\n          contentDescription = null\\n        )\\n      }\\n\\n      Spacer(modifier = Modifier.size(16.dp))\\n\\n      IconButton(\\n        onClick = { navigateToVideoCall(false) },\\n        modifier = Modifier.size(26.dp)\\n      ) {\\n        Icon(\\n          imageVector = WhatsAppIcons.Call,\\n          tint = MaterialTheme.colorScheme.tertiary,\\n          contentDescription = null\\n        )\\n      }\\n\\n      Spacer(modifier = Modifier.size(16.dp))\\n\\n      IconButton(\\n        onClick = {},\\n        modifier = Modifier.size(26.dp)\\n      ) {\\n        Icon(\\n          imageVector = WhatsAppIcons.MoreVert,\\n          tint = MaterialTheme.colorScheme.tertiary,\\n          contentDescription = null\\n        )\\n      }\\n    },\\n    backgroundColor = MaterialTheme.colorScheme.primary\\n  )\\n}\",\n  \"change_summary\": \"Replaced clickable Icons with IconButton to provide proper semantics for accessibility.\",\n  \"confidence\": 100\n}", "parsed": {"fixed_code": "import androidx.compose.foundation.clickable\nimport androidx.compose.foundation.layout.Row\nimport androidx.compose.foundation.layout.Spacer\nimport androidx.compose.foundation.layout.fillMaxWidth\nimport androidx.compose.foundation.layout.padding\nimport androidx.compose.foundation.layout.size\nimport androidx.compose.foundation.shape.CircleShape\nimport androidx.compose.material.TopAppBar\nimport androidx.compose.material3.Icon\nimport androidx.compose.material3.MaterialTheme\nimport androidx.compose.material3.Text\nimport androidx.compose.runtime.Composable\nimport androidx.compose.ui.Modifier\nimport androidx.co